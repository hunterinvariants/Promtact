[Unit]
Description=Promtact database access shipper
Documentation=https://github.com/hunterinvariants/Promtact/blob/main/docs/access-control.md
After=promtact.service postgresql.service
Wants=promtact.service

[Service]
Type=simple
# Runs as the service user with read access to the log only. It needs no
# database credentials: it reads what Postgres already wrote. Group systemd-journal
# covers the journal source; use adm instead when reading a log file.
User=promtact
Group=promtact
SupplementaryGroups=systemd-journal adm
ExecStart=/usr/local/sbin/promtact-access-shipper
EnvironmentFile=/etc/promtact/access-shipper.env
Restart=always
RestartSec=10s

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
# AF_NETLINK is needed even to reach 127.0.0.1: glibc's resolver enumerates the
# available address families through netlink before connecting, so without it
# curl fails with "couldn't connect to server" while the server is fine — a
# failure that looks like the wrong thing entirely.
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=true
UMask=0077

[Install]
WantedBy=multi-user.target
