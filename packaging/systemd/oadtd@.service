[Unit]
Description=Promtact instance %i
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=promtact
Group=promtact
EnvironmentFile=-/etc/promtact/%i.env
Environment=PROMTACT_ADDR=127.0.0.1:8080
Environment=PROMTACT_POLICY_PATH=/etc/promtact/policy.json
WorkingDirectory=/opt/promtact/current
ExecStart=/opt/promtact/current/promtact --addr ${PROMTACT_ADDR} --instance-name %i --public-url ${PROMTACT_PUBLIC_URL} --policy ${PROMTACT_POLICY_PATH}
Restart=on-failure
RestartSec=2

# Sandbox hardening (kept consistent with promtact.service)
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/promtact
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=true
UMask=0077
TasksMax=256
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
