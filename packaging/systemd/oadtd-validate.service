[Unit]
Description=Promtact detection validation (benign ATT&CK emulation suite)
After=promtact.service
Wants=promtact.service

[Service]
Type=oneshot
User=promtact
Group=promtact
WorkingDirectory=/opt/promtact/current
# Validates the inline gateway against benign, ATT&CK-mapped emulations using a
# least-privilege 'ingestor' validation token. The token file must be readable by
# the promtact user (chown promtact:promtact /etc/promtact/validation.token; chmod 600).
# A detection regression makes promtactl exit non-zero, which marks this unit
# failed — pair with an OnFailure= drop-in to alert (or use --continuous --webhook).
ExecStart=/opt/promtact/current/promtactl validate --url http://127.0.0.1:8080 --token-file /etc/promtact/validation.token
EnvironmentFile=-/etc/promtact/validate.env

# Sandbox hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=true
UMask=0077
