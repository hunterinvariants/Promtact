[Unit]
Description=Promtact detection validation (benign ATT&CK emulation suite)
After=promtact.service
Wants=promtact.service
# Fire a one-shot alert when a run regresses or fails to complete.
OnFailure=promtact-validate-alert.service

[Service]
Type=oneshot
User=promtact
Group=promtact
WorkingDirectory=/opt/promtact/current
# Validates the inline gateway against benign, ATT&CK-mapped emulations using a
# least-privilege 'ingestor' validation token. The token file must be readable by
# the promtact user (chown promtact:promtact /etc/promtact/validation.token; chmod 600).
# --output writes the latest result for the dashboard endpoint and the alert
# handler. A detection regression makes promtactl exit non-zero, marking this unit
# failed, which triggers OnFailure=promtact-validate-alert.service.
ExecStart=/opt/promtact/current/promtactl validate --url http://127.0.0.1:8080 --token-file /etc/promtact/validation.token --output /var/lib/promtact/validation-last.json
EnvironmentFile=-/etc/promtact/validate.env
ReadWritePaths=/var/lib/promtact

# Sandbox hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=true
UMask=0077
